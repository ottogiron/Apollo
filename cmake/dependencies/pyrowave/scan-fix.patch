diff --git a/pyrowave_rate_control_test.cpp b/pyrowave_rate_control_test.cpp
new file mode 100644
index 0000000..061ba7d
--- /dev/null
+++ b/pyrowave_rate_control_test.cpp
@@ -0,0 +1,152 @@
+// SPDX-License-Identifier: MIT
+
+#include "device.hpp"
+#include "context.hpp"
+#include "shaders/slangmosh.hpp"
+#include <array>
+#include <cstdio>
+#include <vector>
+
+using namespace Vulkan;
+
+static constexpr unsigned NumBuckets = 2048;
+static constexpr unsigned HeaderWords = 16;
+
+static bool test_scan(Device &device, Program *program, const char *name,
+                      const std::array<uint32_t, NumBuckets> &input)
+{
+	// The first 64 bytes contain other rate control state and must be preserved.
+	std::array<uint32_t, HeaderWords + NumBuckets> data;
+	for (unsigned i = 0; i < HeaderWords; i++)
+		data[i] = 0x12340000u + i;
+	for (unsigned i = 0; i < NumBuckets; i++)
+		data[HeaderWords + i] = input[i];
+
+	BufferCreateInfo info = {};
+	info.domain = BufferDomain::CachedHost;
+	info.usage = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT;
+	info.size = sizeof(data);
+	auto buffer = device.create_buffer(info, data.data());
+	if (!buffer)
+		return false;
+
+	auto cmd = device.request_command_buffer();
+	cmd->set_program(program);
+	cmd->set_storage_buffer(0, 0, *buffer);
+	cmd->dispatch(1, 1, 1);
+	cmd->barrier(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT,
+	             VK_PIPELINE_STAGE_HOST_BIT, VK_ACCESS_HOST_READ_BIT);
+	Fence fence;
+	device.submit(cmd, &fence);
+	fence->wait();
+
+	auto *result = static_cast<const uint32_t *>(device.map_host_buffer(*buffer, MEMORY_ACCESS_READ_BIT));
+	if (!result)
+		return false;
+	bool passed = true;
+	for (unsigned i = 0; i < HeaderWords; i++)
+	{
+		if (result[i] != data[i])
+		{
+			fprintf(stderr, "%s: header word %u was modified\n", name, i);
+			passed = false;
+		}
+	}
+
+	uint32_t sum = 0;
+	unsigned mismatches = 0;
+	for (unsigned i = 0; i < NumBuckets; i++)
+	{
+		sum += input[i];
+		if (result[HeaderWords + i] != sum)
+		{
+			if (mismatches++ == 0)
+				fprintf(stderr, "%s: bucket %u: expected %u, got %u\n",
+				        name, i, sum, result[HeaderWords + i]);
+			passed = false;
+		}
+	}
+	printf("%s: %s (%u mismatches, final sum %u, expected %u)\n",
+	       name, passed ? "PASS" : "FAIL", mismatches, result[HeaderWords + NumBuckets - 1], sum);
+	device.unmap_host_buffer(*buffer, MEMORY_ACCESS_READ_BIT);
+	device.next_frame_context();
+	return passed;
+}
+
+int main(int argc, char **argv)
+{
+	if (argc > 2)
+	{
+		fprintf(stderr, "Usage: pyrowave-rate-control-test [finalize.spv]\n");
+		return 1;
+	}
+
+	if (!Context::init_loader(nullptr))
+		return 1;
+	Context context;
+	context.set_num_thread_indices(1);
+	context.set_system_handles({});
+	if (!context.init_instance_and_device(nullptr, 0, nullptr, 0))
+		return 1;
+	Device device;
+	device.set_context(context);
+	printf("GPU: %s\n", device.get_gpu_properties().deviceName);
+
+	ResourceLayout layout;
+	PyroWave::Shaders<> shaders(device, layout, [](const char *, const char *) { return 0; });
+	auto *program = shaders.analyze_rate_control_finalize;
+	if (!program)
+		return 1;
+	if (argc == 2)
+	{
+		// Also allow testing a GLSL build or an old module as a negative control,
+		// with the same descriptor layout as the shader used by the encoder.
+		FILE *file = fopen(argv[1], "rb");
+		if (!file)
+		{
+			perror(argv[1]);
+			return 1;
+		}
+		if (fseek(file, 0, SEEK_END) != 0)
+		{
+			fclose(file);
+			return 1;
+		}
+		long size = ftell(file);
+		if (size < 20 || size % sizeof(uint32_t) != 0 || fseek(file, 0, SEEK_SET) != 0)
+		{
+			fclose(file);
+			return 1;
+		}
+		std::vector<uint32_t> spirv(size / sizeof(uint32_t));
+		bool valid = fread(spirv.data(), sizeof(uint32_t), spirv.size(), file) == spirv.size() &&
+		             spirv[0] == 0x07230203u;
+		fclose(file);
+		if (!valid)
+			return 1;
+		program = device.request_program(spirv.data(), spirv.size() * sizeof(uint32_t),
+		                                 &program->get_shader(ShaderStage::Compute)->get_layout());
+	}
+	if (!program)
+		return 1;
+
+	bool passed = true;
+	std::array<uint32_t, NumBuckets> input = {};
+	passed &= test_scan(device, program, "zero", input);
+	input.fill(1);
+	passed &= test_scan(device, program, "ones", input);
+	for (unsigned i = 0; i < NumBuckets; i++)
+		input[i] = (i * 17u + (i >> 2u) * 13u) % 101u;
+	passed &= test_scan(device, program, "asymmetric", input);
+
+	// Exercise vector, workgroup-half and end boundaries independently.
+	for (unsigned bucket : { 0u, 3u, 4u, 1023u, 1024u, 2047u })
+	{
+		input.fill(0);
+		input[bucket] = 7;
+		char name[32];
+		snprintf(name, sizeof(name), "impulse-%u", bucket);
+		passed &= test_scan(device, program, name, input);
+	}
+	return passed ? 0 : 1;
+}
